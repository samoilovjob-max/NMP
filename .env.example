CDEK_ACCOUNT=your_account
CDEK_SECURE=your_secure_password
CDEK_API_URL=https://api.cdek.ru/v2
CDEK_FROM_CITY=Петрозаводск
CDEK_FROM_CITY_CODE=450
CDEK_FROM_ADDRESS=Лесной проспект 47

# Карта ПВЗ строится на OpenStreetMap (Leaflet) — ключ не нужен.
# Поле оставлено пустым на случай совместимости:
YANDEX_MAPS_API_KEY=

# ЮKassa: shopId + секретный ключ (секрет только на сервере)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true только для локальных тестов без ЮKassa
PAYMENTS_DEMO=false
# Чек 54-ФЗ (если онлайн-касса в ЮKassa ещё не подключена — поставьте false)
YOOKASSA_SEND_RECEIPT=true
# 1 = без НДС (часто для ИП на спецрежиме)
YOOKASSA_VAT_CODE=1

# Публичный URL сайта для return_url ЮKassa и вебхуков
PUBLIC_BASE_URL=https://northmp.su

# Логин и пароль для /admin.html
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
# Внутренний ключ сессии после входа (не для ручного ввода в форму)
ADMIN_TOKEN=change-me-session-token

# Сколько часов после оплаты даём на отгрузку (для админки)
SHIP_SLA_HOURS=48

# Telegram-уведомления о заказах / заявках (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Username бота без @ (если пусто — определится автоматически)
TELEGRAM_BOT_USERNAME=

# Адрес склада самовывоза (для писем и админки)
PICKUP_ADDRESS=г. Петрозаводск, ул. Университетская 7/3

# Резервные копии data/ (часы между бэкапами и сколько хранить)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

PORT=3000
PACKAGE_WEIGHT=8000
PACKAGE_LENGTH=60
PACKAGE_WIDTH=40
PACKAGE_HEIGHT=10
